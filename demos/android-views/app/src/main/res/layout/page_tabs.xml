<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_demo_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/page_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ts_space_4"
            android:paddingTop="@dimen/ts_space_2"
            android:paddingBottom="@dimen/ts_space_8">

            <TextView
                style="@style/Widget.Demo.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/demo_component_variants" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/demo_component_underline"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.TS.Caption"
                android:textColor="?attr/tsColorTextSecondary" />
            <com.tinysol.designsystem.views.components.tabs.TSTabsView
                style="@style/Widget.Demo.ComponentSample"
                android:layout_width="match_parent"
                android:entries="@array/demo_tabs_sections" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/demo_component_segmented"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.TS.Caption"
                android:textColor="?attr/tsColorTextSecondary" />
            <com.tinysol.designsystem.views.components.tabs.TSTabsView
                style="@style/Widget.Demo.ComponentSample"
                android:layout_width="match_parent"
                android:entries="@array/demo_tabs_short_ranges"
                app:tsTabsVariant="segmented" />

            <TextView
                style="@style/Widget.Demo.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/demo_component_block" />
            <com.tinysol.designsystem.views.components.tabs.TSTabsView
                style="@style/Widget.Demo.ComponentSample"
                android:layout_width="match_parent"
                android:entries="@array/demo_tabs_ranges"
                app:tsBlock="true"
                app:tsTabsVariant="segmented" />
            <com.tinysol.designsystem.views.components.tabs.TSTabsView
                style="@style/Widget.Demo.ComponentSample"
                android:layout_width="match_parent"
                android:entries="@array/demo_tabs_layouts"
                app:tsTabsVariant="segmented" />

            <LinearLayout
                android:id="@+id/tabs_states"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/tabs_overflow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/tabs_playground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
