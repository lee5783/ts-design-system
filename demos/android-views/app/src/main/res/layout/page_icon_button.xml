<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_demo_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/page_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ts_space_4"
            android:paddingTop="@dimen/ts_space_2"
            android:paddingBottom="@dimen/ts_space_8">

            <LinearLayout
                android:id="@+id/icon_button_variants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.Demo.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/demo_heading_tag"
                android:text="@string/demo_component_shapes" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.ts.ds.views.components.iconbutton.TSIconButtonView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/demo_sample_add"
                    app:tsIcon="plus"
                    app:tsVariant="primary" />

                <com.ts.ds.views.components.iconbutton.TSIconButtonView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ts_space_2"
                    android:contentDescription="@string/demo_sample_add"
                    app:tsIcon="plus"
                    app:tsRound="true"
                    app:tsVariant="primary" />

                <com.ts.ds.views.components.iconbutton.TSIconButtonView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ts_space_2"
                    android:contentDescription="@string/demo_sample_more_options"
                    app:tsIcon="more"
                    app:tsRound="true"
                    app:tsVariant="secondary" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Demo.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/demo_heading_tag"
                android:text="@string/demo_component_consumer_icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.ts.ds.views.components.iconbutton.TSIconButtonView
                    android:id="@+id/icon_button_consumer_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/demo_sample_controller" />

                <com.ts.ds.views.components.iconbutton.TSIconButtonView
                    android:id="@+id/icon_button_consumer_icon_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ts_space_2"
                    android:contentDescription="@string/demo_sample_controller"
                    app:tsVariant="secondary" />

                <com.ts.ds.views.components.iconbutton.TSIconButtonView
                    android:id="@+id/icon_button_consumer_icon_round"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ts_space_2"
                    android:contentDescription="@string/demo_sample_controller"
                    app:tsRound="true"
                    app:tsVariant="primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/icon_button_states"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/icon_button_playground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
