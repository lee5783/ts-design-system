<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ts_space_4"
        android:paddingVertical="@dimen/ts_space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settings_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_settings_title"
                android:textAppearance="@style/TextAppearance.TS.Title2"
                android:textColor="?attr/tsColorTextPrimary" />

            <ImageButton
                android:id="@+id/settings_close"
                android:layout_width="@dimen/ts_min_touch_target"
                android:layout_height="@dimen/ts_min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/demo_action_close"
                android:src="@drawable/ts_ic_close"
                app:tint="?attr/tsColorTextPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_theme_header"
            style="@style/Widget.Demo.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_settings_theme" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/settings_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/settings_font_scale_header"
            style="@style/Widget.Demo.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_settings_font_scale" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/settings_font_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_rtl"
            style="@style/Widget.Demo.SettingSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ts_space_2"
            android:text="@string/demo_settings_rtl" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_reduce_motion"
            style="@style/Widget.Demo.SettingSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_settings_reduce_motion" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_reset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ts_space_2"
            android:layout_marginBottom="@dimen/ts_space_4"
            android:text="@string/demo_action_reset" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
