<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_demo_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/page_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ts_space_4"
            android:paddingTop="@dimen/ts_space_2"
            android:paddingBottom="@dimen/ts_space_8">

            <TextView
                style="@style/Widget.Demo.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/demo_heading_tag"
                android:text="@string/demo_component_variants" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_sample_save"
                app:tsVariant="primary" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_sample_cancel"
                app:tsVariant="secondary" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_sample_add_item"
                app:tsLeadingIcon="plus"
                app:tsVariant="ghost" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_sample_delete"
                app:tsLeadingIcon="trash"
                app:tsVariant="danger" />

            <com.ts.ds.views.components.button.TSButtonView
                android:id="@+id/button_link"
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_sample_learn_more"
                app:tsVariant="link" />

            <TextView
                style="@style/Widget.Demo.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/demo_heading_tag"
                android:text="@string/demo_component_sizes" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_sample_continue"
                app:tsSize="md"
                app:tsTrailingIcon="arrow-right" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_sample_get_started"
                app:tsSize="lg" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:layout_width="match_parent"
                android:text="@string/demo_component_block"
                app:tsSize="lg" />

            <LinearLayout
                android:id="@+id/button_states"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.Demo.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/demo_heading_tag"
                android:text="@string/demo_component_with_icons" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_component_leading_icon"
                app:tsLeadingIcon="download"
                app:tsVariant="secondary" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_component_trailing_icon"
                app:tsTrailingIcon="chevron-right"
                app:tsVariant="secondary" />

            <com.ts.ds.views.components.button.TSButtonView
                style="@style/Widget.Demo.ComponentSample"
                android:text="@string/demo_component_both_icons"
                app:tsLeadingIcon="upload"
                app:tsTrailingIcon="arrow-right"
                app:tsVariant="secondary" />

            <LinearLayout
                android:id="@+id/button_playground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
