        <item name="android:paddingTop">@dimen/ts_space_4</item>
        <item name="android:paddingBottom">@dimen/ts_space_1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textAppearance">@style/TextAppearance.TS.Overline</item>
        <item name="android:textColor">?attr/tsColorTextSecondary</item>
