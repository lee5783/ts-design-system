        <item name="android:textAppearance">@style/TextAppearance.TS.BodyLg</item>
        <item name="android:textColor">?attr/tsColorTextPrimary</item>
    </style>

    <style name="Widget.Demo.ComponentSample" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
