root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,ts,js,mjs,cjs,md,xcstrings}]
indent_size = 2

[*.{xml,svg}]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
